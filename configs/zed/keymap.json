      "cmd-w": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false
        }
      ]
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-w": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "Pane",
