{
  "respectGitignore": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"],
    "defaultMode": "auto"
  },
  "theme": "dark",
  "model": "opus[1m]",
  "skipAutoPermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
}
