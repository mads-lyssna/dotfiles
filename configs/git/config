[user]
  name = Madi Ostoja
  email = madeleine.ostoja@lyssna.com

[init]
  defaultBranch = main

[core]
  pager = delta
  excludesfile = ~/.config/git/ignore
  editor = code --wait

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[pull]
  ff = only

[push]
  default = current
  autoSetupRemote = true

[fetch]
  prune = true

[rerere]
  enabled = true
